<%- include('partials/header.ejs') %>

<main class="orders-main">

  <h1 class="orders-title">Your Orders</h1>

  <% if (orders && orders.length > 0) { %>

    <div class="orders-container">

      <% orders.forEach(order => { %>

        <div class="order-card">

          <% if (order.product && order.product.imageString) { %>
            <img src="data:image/png;base64,<%= order.product.imageString %>"
                 alt="<%= order.product.name %>"
                 class="order-image">
          <% } else { %>
            <div class="no-image">No Image</div>
          <% } %>

          <div class="order-info">
            <h3><%= order.product?.name || "Deleted Product" %></h3>

            <p><strong>Quantity:</strong> <%= order.quantity %></p>
            <p><strong>Total:</strong> Rs <%= order.totalPrice %></p>

            <p>
              <strong>Status:</strong>
              <span class="status <%= (order.status || '').toLowerCase() %>">
                <%= order.status %>
              </span>
            </p>

            <p class="order-date">
              Ordered on: <%= order.createdAt ? order.createdAt.toDateString() : "" %>
            </p>
          </div>

          <div class="order-actions">

            <% if (order.status === 'Pending') { %>
              <form action="/orders/<%= order._id %>/pay" method="POST">
                <button class="btn btn-primary">Pay</button>
              </form>
            <% } else { %>
              <p class="paid-label">Paid</p>
            <% } %>

            <form action="/orders/<%= order._id %>/delete" method="POST">
              <button class="btn btn-danger">Delete</button>
            </form>

          </div>

        </div>

      <% }) %>

    </div>

  <% } else { %>
    <p class="no-orders">No orders placed yet.</p>
  <% } %>

</main>

<%- include('partials/footer') %>
