<%- include('partials/header.ejs') %>

<main class="container my-5">

  <div class="text-center mb-5">
    <h1 class="display-5 fw-bold"><%= restaurantName %></h1>
    <p class="text-muted">Fresh food made with care.</p>
  </div>

  <form action="/" method="GET" class="menu-filter">
    <div class="filter-search">
      <label class="form-label" for="search">Search menu</label>
      <input type="search" id="search" name="search" class="form-control" placeholder="Search by item name" value="<%= search || '' %>">
    </div>

    <div>
      <label class="form-label" for="category">Category</label>
      <select id="category" name="category" class="form-select">
        <% ['All', 'Food', 'Beverage'].forEach(option => { %>
          <option value="<%= option %>" <%= category === option ? 'selected' : '' %>><%= option %></option>
        <% }) %>
      </select>
    </div>

    <div class="filter-actions">
      <button class="btn btn-primary" type="submit">Filter</button>
      <a class="btn btn-secondary" href="/">Reset</a>
    </div>
  </form>

  <div class="row g-4">

    <% if (products && products.length > 0) { %>

      <% products.forEach(product => { %>

        <div class="col-md-4">

          <div class="card shadow-sm h-100 product-card">

            <% if (product.imageString) { %>
              <img src="data:image/png;base64,<%= product.imageString %>" class="card-img-top product-img">
            <% } else { %>
              <div class="no-image-box">No Image</div>
            <% } %>

            <div class="card-body d-flex flex-column">

              <h5 class="card-title"><%= product.name %></h5>
              <p class="text-muted mb-1"><%= product.category %></p>
              <h6 class="fw-bold">Rs <%= product.price %></h6>
              <p class="stock-note"><%= product.stock || 0 %> available</p>

              <form action="/orders" method="POST" class="mt-auto">

                <input type="hidden" name="productId" value="<%= product._id %>">

                <input type="number" name="quantity" class="form-control mb-2" min="1" max="<%= product.stock || 1 %>" value="1" <%= (product.stock || 0) <= 0 ? 'disabled' : '' %>>

                <% if ((product.stock || 0) > 0) { %>
                  <button class="btn btn-success w-100">
                    Order Now
                  </button>
                <% } else { %>
                  <button class="btn btn-secondary w-100" disabled>
                    Out of Stock
                  </button>
                <% } %>

              </form>

            </div>

          </div>

        </div>

      <% }) %>

    <% } else { %>

      <p class="text-center">No products found.</p>

    <% } %>

  </div>

</main>

<%- include('partials/footer') %>
