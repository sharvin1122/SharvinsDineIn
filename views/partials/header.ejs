<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sharvin's Dine In</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark main-navbar sticky-top">
  <div class="container">

    <a class="navbar-brand brand-mark" href="/">
      <img src="/images/sharvins-logo.svg" alt="Sharvin's Dine In logo" class="brand-logo">
      <span>Sharvin's Dine In</span>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navMenu">

      <ul class="navbar-nav ms-auto">

        <% if (user && user.perms !== 'admin') { %>
          <li class="nav-item">
            <a class="nav-link" href="/">Home</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/orders">Orders</a>
          </li>
        <% } else if (user && user.perms === 'admin') { %>
          <li class="nav-item">
            <a class="nav-link" href="/admin">Products & Orders</a>
          </li>
        <% } %>

        <li class="nav-item">
          <a class="nav-link" href="/about">About</a>
        </li>

        <% if (user) { %>
          <li class="nav-item">
            <form action="/logout" method="POST" class="nav-logout">
              <button type="submit" class="nav-link logout-button">Logout</button>
            </form>
          </li>
        <% } else { %>
          <li class="nav-item">
            <a class="nav-link" href="/login">Login</a>
          </li>
        <% } %>

      </ul>

    </div>

  </div>
</nav>

<% if (flash) { %>
  <div class="container flash-container">
    <div class="alert alert-<%= flash.type %> alert-dismissible fade show" role="alert">
      <%= flash.message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  </div>
<% } %>
