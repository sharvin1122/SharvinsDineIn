<%- include('partials/header.ejs') %>

<main class="home-main">

  <h1 class="home-title">About Us</h1>

  <section class="about-section">

    <p>
      Welcome to <strong>Sharvin's Dine In</strong>!  
      We serve fresh meals with passion and care.  
      Thank you for visiting us.
    </p>

    <div class="about-actions">
      <h3>Contact Us</h3>

      <a href="mailto:yourname@example.com" class="btn btn-primary">
        Email Us
      </a>
    </div>

    <div class="about-actions">
      <h3>Rate Us</h3>

      <div class="stars" id="starRating">
        <span data-value="1">★</span>
        <span data-value="2">★</span>
        <span data-value="3">★</span>
        <span data-value="4">★</span>
        <span data-value="5">★</span>
      </div>

      <p class="rate-text" id="rateMessage">
        Click on the stars to rate us!
      </p>
    </div>

  </section>

</main>

<script>
  const stars = document.querySelectorAll("#starRating span");
  const message = document.getElementById("rateMessage");

  stars.forEach((star, index) => {
    star.addEventListener("click", () => {

      stars.forEach(s => s.style.color = "#ccc");

      for (let i = 0; i <= index; i++) {
        stars[i].style.color = "#FFD700";
      }

      message.textContent = `You rated us ${index + 1} star${index > 0 ? "s" : ""}!`;
    });
  });
</script>

<%- include('partials/footer') %>
