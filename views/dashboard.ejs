<%- include('partials/header.ejs') %>

<main class="admin-main">
<div class="container admin-dashboard my-5">
  <div class="admin-heading">
    <div>
      <span>Admin panel</span>
      <h1>Dashboard</h1>
      <p>Manage menu items, stock and customer orders.</p>
      <% if (demoMode) { %>
        <div class="alert alert-warning demo-admin-alert">
          Demo access is read-only, so create, edit, delete, and status changes are not saved.
        </div>
      <% } %>
    </div>
    <div class="admin-heading-actions">
      <button id="formBtn" class="btn btn-primary" type="button" onclick="toggleSection('formSection','formBtn','+ Create Product','- Hide Form')">
        + Create Product
      </button>
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-lg-3 col-md-4 col-6">
      <div class="stat-card">
        <span>Total Products</span>
        <strong><%= stats.totalProducts %></strong>
      </div>
    </div>
    <div class="col-lg-3 col-md-4 col-6">
      <div class="stat-card">
        <span>Total Orders</span>
        <strong><%= stats.totalOrders %></strong>
      </div>
    </div>
    <div class="col-lg-3 col-md-4 col-6">
      <div class="stat-card">
        <span>Pending</span>
        <strong><%= stats.pendingOrders %></strong>
      </div>
    </div>
    <div class="col-lg-3 col-md-4 col-6">
      <div class="stat-card">
        <span>Total Sales</span>
        <strong>Rs <%= stats.totalSales %></strong>
      </div>
    </div>
    <div class="col-lg-4 col-md-4 col-6">
      <div class="stat-card sales-card">
        <span>Daily Sales</span>
        <strong>Rs <%= stats.dailySales %></strong>
      </div>
    </div>
    <div class="col-lg-4 col-md-4 col-6">
      <div class="stat-card sales-card">
        <span>Monthly Sales</span>
        <strong>Rs <%= stats.monthlySales %></strong>
      </div>
    </div>
    <div class="col-lg-4 col-md-4 col-12">
      <div class="stat-card sales-card">
        <span>Yearly Sales</span>
        <strong>Rs <%= stats.yearlySales %></strong>
      </div>
    </div>
  </div>

  <div id="formSection" class="card card-body admin-create-form mb-4" style="display:none;">
    <form action="/admin/add" method="POST" enctype="multipart/form-data">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Name</label>
          <input type="text" name="name" class="form-control" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Category</label>
          <select name="category" class="form-select">
            <option value="Main">Main</option>
            <option value="Combo & Meals">Combo & Meals</option>
            <option value="Sides">Sides</option>
            <option value="Drinks">Drinks</option>
            <option value="Coffee">Coffee</option>
            <option value="Dessert">Dessert</option>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Price</label>
          <input type="number" name="price" class="form-control" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">Stock</label>
          <input type="number" name="stock" class="form-control" value="1" min="1">
        </div>
        <div class="col-md-8">
          <label class="form-label">Product Image</label>
          <input type="file" name="image" class="form-control" accept="image/*">
          <small class="text-muted">Choose a downloaded image from your Mac.</small>
        </div>
      </div>
      <div class="mt-3">
        <button type="submit" class="btn btn-success">Add Product</button>
      </div>
    </form>
  </div>

  <section class="admin-section">
    <div class="admin-section-head">
      <div>
        <span class="section-count"><%= activeOrders.length %> active</span>
        <h2 class="section-title">Active Orders</h2>
      </div>
      <button class="btn btn-outline-primary section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#activeOrdersSection" aria-expanded="false" aria-controls="activeOrdersSection">
        <span class="show-label">Show</span>
        <span class="hide-label">Hide</span>
      </button>
    </div>

    <div class="collapse dashboard-collapse" id="activeOrdersSection">
      <% if (activeOrders.length > 0) { %>
        <div class="admin-order-list">
          <% activeOrders.forEach(order => { %>
            <% const lines = order.items && order.items.length > 0 ? order.items : [{
              name: order.product?.name || 'Deleted Product',
              quantity: order.quantity,
              addOns: order.addOns || []
            }]; %>
            <% const addOnNames = lines.flatMap(line => line.addOns || []).map(item => item.name); %>
            <article class="admin-order-card">
              <div class="admin-order-main">
                <div>
                  <span class="section-eyebrow"><%= order.createdAt ? order.createdAt.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) : '' %></span>
                  <h3><%= order.user?.full_name || 'Guest' %></h3>
                  <p><%= order.user?.email || 'No email' %></p>
                </div>
                <span class="status <%= (order.status || '').toLowerCase() %>"><%= order.status %></span>
              </div>

              <div class="admin-order-lines">
                <% lines.forEach(line => { %>
                  <div>
                    <strong><%= line.name %></strong>
                    <span>x <%= line.quantity %></span>
                  </div>
                <% }) %>
              </div>

              <div class="admin-order-details">
                <div>
                  <span>Add-ons</span>
                  <strong><%= addOnNames.length > 0 ? addOnNames.join(', ') : 'None' %></strong>
                </div>
                <div>
                  <span>Comment</span>
                  <strong><%= order.comment || 'None' %></strong>
                </div>
                <div>
                  <span>Total</span>
                  <strong>Rs <%= order.totalPrice %></strong>
                </div>
              </div>

              <form action="/admin/orders/<%= order._id %>/status" method="POST" class="status-form admin-order-actions">
                <select name="status" class="form-select form-select-sm">
                  <% ['Pending', 'Paid', 'Preparing', 'Ready', 'Completed', 'Canceled'].forEach(status => { %>
                    <option value="<%= status %>" <%= order.status === status ? 'selected' : '' %>><%= status %></option>
                  <% }) %>
                </select>
                <button class="btn btn-primary btn-sm" type="submit">Save</button>
              </form>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-panel">No active orders.</div>
      <% } %>
    </div>
  </section>

  <section class="admin-section">
    <div class="admin-section-head">
      <div>
        <span class="section-count"><%= closedOrders.length %> orders</span>
        <h2 class="section-title">Paid & Completed</h2>
      </div>
      <button class="btn btn-outline-primary section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#closedOrdersSection" aria-expanded="false" aria-controls="closedOrdersSection">
        <span class="show-label">Show</span>
        <span class="hide-label">Hide</span>
      </button>
    </div>

    <div class="collapse dashboard-collapse" id="closedOrdersSection">
      <% if (closedOrders.length > 0) { %>
        <div class="admin-order-list closed-orders">
          <% closedOrders.forEach(order => { %>
            <% const lines = order.items && order.items.length > 0 ? order.items : [{
              name: order.product?.name || 'Deleted Product',
              quantity: order.quantity,
              addOns: order.addOns || []
            }]; %>
            <article class="admin-order-card compact">
              <div class="admin-order-main">
                <div>
                  <span class="section-eyebrow"><%= order.createdAt ? order.createdAt.toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) : '' %></span>
                  <h3><%= order.user?.full_name || 'Guest' %></h3>
                  <p><%= lines.map(line => `${line.name} x ${line.quantity}`).join(', ') %></p>
                </div>
                <span class="status <%= (order.status || '').toLowerCase() %>"><%= order.status %></span>
              </div>
              <div class="admin-order-details">
                <div>
                  <span>Total</span>
                  <strong>Rs <%= order.totalPrice %></strong>
                </div>
                <form action="/admin/orders/<%= order._id %>/status" method="POST" class="status-form admin-order-actions">
                  <select name="status" class="form-select form-select-sm">
                    <% ['Pending', 'Paid', 'Preparing', 'Ready', 'Completed', 'Canceled'].forEach(status => { %>
                      <option value="<%= status %>" <%= order.status === status ? 'selected' : '' %>><%= status %></option>
                    <% }) %>
                  </select>
                  <button class="btn btn-primary btn-sm" type="submit">Save</button>
                </form>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-panel">No paid or completed orders yet.</div>
      <% } %>
    </div>
  </section>

  <div class="admin-products-head">
    <div>
      <span class="section-count"><%= items.length %> menu items</span>
      <h2 class="section-title">Products</h2>
    </div>
    <button class="btn btn-outline-primary section-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#tableSection" aria-expanded="false" aria-controls="tableSection">
      <span class="show-label">Show Products</span>
      <span class="hide-label">Hide Products</span>
    </button>
  </div>

  
<div id="tableSection" class="collapse dashboard-collapse">

  <div class="row g-4">

    <% if (items.length > 0) { %>
      <% items.forEach(item => { %>

        <div class="col-lg-3 col-md-4 col-sm-6">

          <div class="card admin-product-card h-100">

            <% if (item.imageString) { %>
              <img src="data:image/png;base64,<%= item.imageString %>"
                   class="card-img-top admin-product-img">
            <% } else if (item.imageUrl) { %>
              <img src="<%= item.imageUrl %>"
                   class="card-img-top admin-product-img">
            <% } else { %>
              <div class="admin-no-image">
                No Image
              </div>
            <% } %>

            <div class="card-body admin-product-body d-flex flex-column">

              <h6 class="fw-bold mb-1"><%= item.name %></h6>
              <p class="admin-product-category mb-1"><%= item.category %></p>

              <div class="admin-product-meta">
                <span>Rs <%= item.price %></span>
                <span><%= item.stock %> in stock</span>
              </div>

              <div class="admin-card-actions mt-auto">
                <button class="btn btn-primary btn-sm w-100" type="button" onclick="toggleSection('editProduct<%= item._id %>','editBtn<%= item._id %>','Edit','Hide Edit')" id="editBtn<%= item._id %>">
                  Edit
                </button>
              </div>

              <form action="/admin/delete/<%= item._id %>" method="POST" class="mt-2">
                <button class="btn btn-danger btn-sm w-100"
                        onclick="return confirm('Delete this item?')">
                  Delete
                </button>
              </form>

            </div>

            <div id="editProduct<%= item._id %>" class="product-edit-panel" style="display:none;">
              <form action="/admin/edit/<%= item._id %>" method="POST" enctype="multipart/form-data">
                <label class="form-label">Name</label>
                <input type="text" name="name" class="form-control form-control-sm" value="<%= item.name %>" required>

                <label class="form-label mt-2">Category</label>
                <select name="category" class="form-select form-select-sm">
                  <% ['Main', 'Combo & Meals', 'Sides', 'Drinks', 'Coffee', 'Dessert'].forEach(option => { %>
                    <option value="<%= option %>" <%= item.category === option ? 'selected' : '' %>><%= option %></option>
                  <% }) %>
                </select>

                <div class="row g-2 mt-1">
                  <div class="col-6">
                    <label class="form-label">Price</label>
                    <input type="number" name="price" class="form-control form-control-sm" min="0" value="<%= item.price %>" required>
                  </div>
                  <div class="col-6">
                    <label class="form-label">Stock</label>
                    <input type="number" name="stock" class="form-control form-control-sm" min="0" value="<%= item.stock || 0 %>" required>
                  </div>
                </div>

                <label class="form-label mt-2">Replace Image</label>
                <input type="file" name="image" class="form-control form-control-sm" accept="image/*">

                <button class="btn btn-success btn-sm w-100 mt-3" type="submit">Save Changes</button>
              </form>
            </div>

          </div>

        </div>

      <% }) %>
    <% } else { %>

      <div class="col-12 text-center">
        <p>No items yet!</p>
      </div>

    <% } %>

  </div>

</div>

</div>
</main>

<script>
function toggleSection(sectionId, btnId, showText, hideText){
  const sec = document.getElementById(sectionId);
  const btn = document.getElementById(btnId);
  if(sec.style.display==='none'){ sec.style.display='block'; btn.textContent=hideText; }
  else { sec.style.display='none'; btn.textContent=showText; }
}

</script>

<%- include('partials/footer') %>
